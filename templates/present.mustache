{{!
    @template mod_storychain/present

    The projector page: the story (present_state is rendered into it) and the step controls beside it.

    Context variables required for this template:
    * cmid - Course module id
    * name - Activity name (formatted)
    * viewurl - Back to the live view
    * hasothers, others - Other finished stories to switch to (heading, url, current)

    Example context (json):
    {
        "cmid": 12,
        "name": "Spooky stories",
        "viewurl": "https://example.com/mod/storychain/view.php?id=12",
        "hasothers": true,
        "others": [
            {"heading": "Story 1", "url": "https://example.com/mod/storychain/present.php?id=12&group=0&chainid=7", "current": true},
            {"heading": "Story 2", "url": "https://example.com/mod/storychain/present.php?id=12&group=0&chainid=8", "current": false}
        ]
    }
}}
<div class="mod-storychain mod-storychain-presentview" data-region="mod-storychain-present" data-cmid="{{cmid}}">
    <div class="mod-storychain-present-main">
        <p class="text-muted mb-1">{{{name}}}</p>
        <div data-region="present-state">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span class="visually-hidden">{{#str}}loading, mod_storychain{{/str}}</span>
        </div>
    </div>
    <aside class="mod-storychain-present-controls" aria-label="{{#str}}presentcontrols, mod_storychain{{/str}}">
        <div class="d-grid gap-2">
            <button type="button" class="btn btn-primary btn-lg" data-action="next">{{#str}}nextsentence, mod_storychain{{/str}}</button>
            <button type="button" class="btn btn-secondary" data-action="prev">{{#str}}previoussentencebutton, mod_storychain{{/str}}</button>
            <button type="button" class="btn btn-secondary" data-action="showall">{{#str}}showall, mod_storychain{{/str}}</button>
            <button type="button" class="btn btn-outline-secondary" data-action="stop">{{#str}}stoppresenting, mod_storychain{{/str}}</button>
        </div>
        <p class="small text-muted mt-2">{{#str}}presentkeys, mod_storychain{{/str}}</p>
        {{#hasothers}}
            <nav class="mt-3" aria-labelledby="mod-storychain-others">
                <h2 class="h6" id="mod-storychain-others">{{#str}}otherstories, mod_storychain{{/str}}</h2>
                <ul class="list-unstyled">
                    {{#others}}
                        <li>{{#current}}<strong aria-current="page">{{{heading}}}</strong>{{/current}}{{^current}}<a href="{{url}}">{{{heading}}}</a>{{/current}}</li>
                    {{/others}}
                </ul>
            </nav>
        {{/hasothers}}
        <p class="mt-3"><a href="{{viewurl}}">{{#str}}backtoliveview, mod_storychain{{/str}}</a></p>
    </aside>
</div>
