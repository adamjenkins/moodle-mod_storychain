{{!
    @template mod_storychain/present_state

    The story as far as the teacher has stepped through it, in large type for a projector.

    Context variables required for this template:
    * chain - The chain being presented (heading, items with shown/latest, presentpos, itemcount, atstart, atend)

    Example context (json):
    {
        "chain": {
            "heading": "The lost key",
            "presentpos": 1,
            "itemcount": 2,
            "atstart": false,
            "atend": false,
            "items": [{"text": "Once upon a time.", "shown": true, "latest": true}, {"text": "A key fell.", "shown": false, "latest": false}]
        }
    }
}}
<div class="mod-storychain-presentstate">
    {{#chain}}
        <h1 class="mod-storychain-present-heading">{{{heading}}}</h1>
        <ol class="list-unstyled mod-storychain-present-story" aria-live="polite">
            {{#items}}{{#shown}}
                <li{{#latest}} class="mod-storychain-latest"{{/latest}}>{{text}}</li>
            {{/shown}}{{/items}}
        </ol>
        {{#atstart}}<p class="text-muted">{{#str}}presentstart, mod_storychain{{/str}}</p>{{/atstart}}
        <p class="small text-muted">{{#str}}presentprogress, mod_storychain, { "position": {{presentpos}}, "total": {{itemcount}} }{{/str}}</p>
    {{/chain}}
    {{^chain}}
        <div class="alert alert-warning">{{#str}}invalidchain, mod_storychain{{/str}}</div>
    {{/chain}}
</div>
