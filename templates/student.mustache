{{!
    @template mod_storychain/student

    The student's page: a live region the student_state template is rendered into.

    Context variables required for this template:
    * cmid - Course module id

    Example context (json):
    {
        "cmid": 12
    }
}}
<div class="mod-storychain mod-storychain-studentview" data-region="mod-storychain-student" data-cmid="{{cmid}}">
    <div class="visually-hidden" aria-live="assertive" data-region="announce"></div>
    <div data-region="student-state">
        <div class="d-flex align-items-center gap-2 text-muted">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>{{#str}}loading, mod_storychain{{/str}}</span>
        </div>
    </div>
</div>
