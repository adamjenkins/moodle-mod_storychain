{{!
    @template mod_storychain/teacher

    The teacher's live view: the teacher_state template is rendered into it.

    Context variables required for this template:
    * cmid - Course module id
    * groupid - Group shown

    Example context (json):
    {
        "cmid": 12,
        "groupid": 0
    }
}}
<div class="mod-storychain mod-storychain-teacherview" data-region="mod-storychain-teacher" data-cmid="{{cmid}}" data-groupid="{{groupid}}">
    <div class="visually-hidden" aria-live="polite" data-region="announce"></div>
    <div data-region="teacher-state">
        <div class="d-flex align-items-center gap-2 text-muted">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>{{#str}}loading, mod_storychain{{/str}}</span>
        </div>
    </div>
</div>
